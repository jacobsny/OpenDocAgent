# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# MacOS
.DS_Store

# Generated output files (presentations, documents)
*.pptx
*.docx
*.pdf
*.tex
*.latex

# Allow tracking core LaTeX style sheets/templates
!opendocagent/templates/**/*.tex

# Document workspaces — never commit in-progress or finalized docs
wip/
finalized/
